APP_NAME="Nexo"
NEXT_PUBLIC_APP_NAME="Nexo"
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postline:postline@127.0.0.1:5433/postline
REDIS_URL=redis://127.0.0.1:6380

# Auth.js
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dev: magic links are logged to the server console when no SMTP/Resend key is set
RESEND_API_KEY=
EMAIL_FROM="Nexo <no-reply@localhost>"

# 32-byte key, base64 — encrypts channel tokens at rest
TOKEN_ENCRYPTION_KEY=

# AI — OpenAI-compatible provider (Agnes AI) takes precedence over Anthropic when set
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=agnes-3.0-flash
AI_FAST_MODEL=agnes-3.0-flash

# Network apps (fill as approvals land)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Media storage (S3-compatible). Dev falls back to apps/web/public/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Image generation — IMAGE_MODEL on the OpenAI-compatible LLM host (Agnes) is used first; falls back to local artwork
IMAGE_MODEL=agnes-image-2.5-flash
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=
# Meta inbox webhooks
META_VERIFY_TOKEN=

# Composio — managed OAuth for LinkedIn, Facebook, Instagram, YouTube, Pinterest (no app review)
COMPOSIO_API_KEY=
# X needs your own app registered in Composio as an auth config (ac_...)
COMPOSIO_AUTH_CONFIG_TWITTER=

# Public base URL serving apps/web/public (npm run media:serve + media:tunnel). Needed for Instagram/Facebook media in dev.
PUBLIC_MEDIA_BASE_URL=

# Where contact-form messages go (and the public support address)
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
